{
  "name": "cnxh-khoa-hoc-trong-doi-song",
  "version": "2.0.0",
  "description": "Scientific Socialism learning platform based on the 2021 textbook",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build-public.js",
    "prestart": "npm run build",
